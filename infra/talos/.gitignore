# Generated by talhelper — contains cluster CA key material
clusterconfig/
talosconfig

# Plaintext secrets — never commit, only talsecret.sops.yaml is committed
talsecret.yaml

# Generated at runtime by just talos-generate from SOPS
patches/custom-ca.yaml

# Large flash images — download from Talos factory, don't commit
flashing/*.img
flashing/*.img.zst
flashing/*.iso
